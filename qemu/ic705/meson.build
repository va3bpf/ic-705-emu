# Device models written by this project. build-qemu.sh links this directory
# to hw/arm/ic705; hw/arm/meson.build includes it with subdir('ic705').
arm_common_ss.add(when: 'CONFIG_RZA1H', if_true: files(
  'adc.c',
  'board.c',
  'charger.c',
  'dmac_ch0_7.c',
  'dmac_ch8_15.c',
  'dsp.c',
  'dv_dsp.c',
  'eeprom.c',
  'gnss.c',
  'mtu2_timer.c',
  'panel_input.c',
  'power.c',
  'rspi.c',
  'spi_flash.c',
  'subcpu_link.c',
  'touch.c',
  'wlan.c',
  'subcpu/adc.c',
  'subcpu/dma.c',
  'subcpu/exti.c',
  'subcpu/flash.c',
  'subcpu/gpio.c',
  'subcpu/rcc.c',
  'subcpu/soc.c',
  'subcpu/spi.c',
  'subcpu/timer.c',
  'subcpu/usart.c',
))
