--- a/hw/intc/arm_gic.c
+++ b/hw/intc/arm_gic.c
@@ -91,7 +91,12 @@ static inline void gic_get_best_irq(GICState *s, int cpu,
     *best_irq = 1023;
     *best_prio = 0x100;
 
-    for (irq = 0; irq < s->num_irq; irq++) {
+    for (irq = find_first_bit(s->irq_cand, s->num_irq); irq < s->num_irq;
+         irq = find_next_bit(s->irq_cand, s->num_irq, irq + 1)) {
+        if (!s->irq_state[irq].pending && !s->irq_state[irq].level) {
+            clear_bit(irq, s->irq_cand);    /* cannot be pending: skip it */
+            continue;
+        }
         if (GIC_DIST_TEST_ENABLED(irq, cm) && gic_test_pending(s, irq, cm) &&
             (!GIC_DIST_TEST_ACTIVE(irq, cm)) &&
             (irq < GIC_INTERNAL || GIC_DIST_TARGET(irq) & cm)) {
@@ -1421,6 +1426,7 @@ static void gic_dist_writeb(void *opaque, hwaddr offset,
                  * pending updates the set of CPUs it is pending on.
                  */
                 s->irq_state[irq].pending = value & ALL_CPU_MASK;
+                set_bit(irq, s->irq_cand);
             }
         }
     } else if (offset < 0xf00) {
