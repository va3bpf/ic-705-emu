@@ -81,13 +81,69 @@ static int64_t icount_get_executed(CPUState *cpu)
  * account executed instructions. This is done by the TCG vCPU
  * thread so the main-loop can see time has moved forward.
  */
+/*
+ * QEMU_ICOUNT_CPU_SCALE="s0,s1,...": units of the instruction counter one
+ * instruction of each vCPU costs, by cpu_index. Every unit is 2^shift ns, so
+ * with shift=1 a scale of 32 runs that CPU at 15.6 MIPS: a 16 MHz Cortex-M0
+ * beside a Cortex-A9 that runs at 500 MIPS. With one scale for all CPUs a
+ * slow microcontroller polling its GPIOs executes as many instructions as
+ * the main CPU and costs as much host time.
+ */
+#define ICOUNT_MAX_SCALES 16
+
+
+bool icount_rr_parallel(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *e = getenv("QEMU_ICOUNT_RR_PARALLEL");
+        on = e && *e && strcmp(e, "0") != 0;
+    }
+    return on;
+}
+
+int64_t icount_raw_peek(void)
+{
+    return qatomic_read(&timers_state.qemu_icount);
+}
+
+/* ICOUNT_PAR: only the vCPU thread moves the counter, with no vCPU running */
+void icount_raw_set(int64_t v)
+{
+    seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                       &timers_state.vm_clock_lock);
+    qatomic_set(&timers_state.qemu_icount, v);
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                         &timers_state.vm_clock_lock);
+}
+
+int icount_cpu_scale(CPUState *cpu)
+{
+    static int scale[ICOUNT_MAX_SCALES];
+    static bool parsed;
+
+    if (!parsed) {
+        const char *e = getenv("QEMU_ICOUNT_CPU_SCALE");
+        g_auto(GStrv) parts = g_strsplit(e ? e : "", ",", ICOUNT_MAX_SCALES);
+        int n = g_strv_length(parts);
+
+        for (int i = 0; i < ICOUNT_MAX_SCALES; i++) {
+            int x = i < n ? atoi(parts[i]) : 1;
+            scale[i] = x > 0 ? x : 1;
+        }
+        parsed = true;
+    }
+    return cpu->cpu_index < ICOUNT_MAX_SCALES ? scale[cpu->cpu_index] : 1;
+}
+
 static void icount_update_locked(CPUState *cpu)
 {
     int64_t executed = icount_get_executed(cpu);
     cpu->icount_budget -= executed;
 
     qatomic_set(&timers_state.qemu_icount,
-                timers_state.qemu_icount + executed);
+                timers_state.qemu_icount + executed * icount_cpu_scale(cpu));
 }
 
