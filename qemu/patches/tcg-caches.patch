diff --git a/target/arm/helper.c b/target/arm/helper.c
index af45234..883a900 100644
--- a/target/arm/helper.c
+++ b/target/arm/helper.c
@@ -392,11 +392,14 @@ static void contextidr_write(CPUARMState *env, const ARMCPRegInfo *ri,
 {
     ARMCPU *cpu = env_archcpu(env);
 
-    if (raw_read(env, ri) != value && !arm_feature(env, ARM_FEATURE_PMSA)
+    if (((raw_read(env, ri) ^ value) & 0xff) && !arm_feature(env, ARM_FEATURE_PMSA)
         && !extended_addresses_enabled(env)) {
         /*
          * For VMSA (when not using the LPAE long descriptor page table
-         * format) this register includes the ASID, so do a TLB flush.
+         * format) bits [7:0] of this register are the ASID, so do a TLB
+         * flush when they change. Bits [31:8] are PROCID, which does not
+         * affect translation: an RTOS that writes its task number there on
+         * every context switch must not flush the TLB each time.
          * For PMSA it is purely a process ID and no action is needed.
          */
         tlb_flush(CPU(cpu));
