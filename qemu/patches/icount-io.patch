+/*
+ * Set of (cpu, guest pc) pairs of instructions that did device I/O in the
+ * middle of a TB under icount. A guest polling a device register in a tight
+ * loop otherwise pays a longjmp, a TB lookup by host pc, a state restore and
+ * a TB exit on every single access.
+ */
+static GHashTable *io_insns;
+static QemuMutex io_insns_lock;
+static gsize io_insns_init;
+
+static uint64_t io_insn_key(CPUState *cpu, vaddr pc)
+{
+    return ((uint64_t)cpu->cpu_index << 56) ^ (uint64_t)pc;
+}
+
+static void io_insns_setup(void)
+{
+    if (g_once_init_enter(&io_insns_init)) {
+        qemu_mutex_init(&io_insns_lock);
+        io_insns = g_hash_table_new_full(g_int64_hash, g_int64_equal,
+                                         g_free, NULL);
+        g_once_init_leave(&io_insns_init, 1);
+    }
+}
+
+bool tcg_io_insn_known(CPUState *cpu, vaddr pc)
+{
+    uint64_t key = io_insn_key(cpu, pc);
+    bool found;
+
+    if (!qatomic_read(&io_insns_init)) {
+        return false;
+    }
+    qemu_mutex_lock(&io_insns_lock);
+    found = g_hash_table_contains(io_insns, &key);
+    qemu_mutex_unlock(&io_insns_lock);
+    return found;
+}
+
+static bool io_insn_remember(CPUState *cpu, vaddr pc)
+{
+    uint64_t *key = g_new(uint64_t, 1);
+    bool added;
+
+    io_insns_setup();
+    *key = io_insn_key(cpu, pc);
+    qemu_mutex_lock(&io_insns_lock);
+    added = g_hash_table_add(io_insns, key);
+    qemu_mutex_unlock(&io_insns_lock);
+    return added;
+}
+
 /*
  * In deterministic execution mode, instructions doing device I/Os
  * must be at the end of the TB.
