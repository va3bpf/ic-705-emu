+/*
+ * icount: bus wait states for device accesses. Plain icount charges a device
+ * register access like any other insn, so a guest polling a slow peripheral
+ * bus runs far more iterations per virtual second than real hardware does.
+ * QEMU_ICOUNT_IO_WAIT=N charges N extra insns of virtual time per access.
+ * The charge is taken from the current budget only, so it never moves time
+ * past the next timer deadline, and it is deterministic.
+ */
+#define IO_WAIT_MAX_CPUS 16
+/*
+ * QEMU_ICOUNT_IO_WAIT=N applies to every CPU; "N0,N1,..." sets it by
+ * cpu_index (CPUs past the list get 0). The peripheral bus of a Cortex-A SoC
+ * and the single-cycle I/O port of a Cortex-M0+ microcontroller cost very
+ * different amounts of time.
+ */
+static int io_wait_insns(CPUState *cpu)
+{
+    static int insns[IO_WAIT_MAX_CPUS];
+    static bool parsed;
+
+    if (!parsed) {
+        const char *e = getenv("QEMU_ICOUNT_IO_WAIT");
+        g_auto(GStrv) parts = g_strsplit(e ? e : "", ",", IO_WAIT_MAX_CPUS);
+        int n = g_strv_length(parts);
+
+        for (int i = 0; i < IO_WAIT_MAX_CPUS; i++) {
+            const char *v = n == 1 ? parts[0] : i < n ? parts[i] : NULL;
+            int x = v ? atoi(v) : 0;
+            insns[i] = x > 0 ? MIN(x, 0xffff) : 0;
+        }
+        parsed = true;
+    }
+    return cpu->cpu_index < IO_WAIT_MAX_CPUS ? insns[cpu->cpu_index] : 0;
+}
+
+static void io_charge_wait(CPUState *cpu)
+{
+    int64_t k = io_wait_insns(cpu);
+    int64_t low;
+
+    if (!k || !icount_enabled() || !(curr_cflags(cpu) & CF_USE_ICOUNT)) {
+        return;
+    }
+    if (cpu->icount_extra >= k) {
+        cpu->icount_extra -= k;
+        return;
+    }
+    k -= cpu->icount_extra;
+    cpu->icount_extra = 0;
+    low = cpu->neg.icount_decr.u16.low;
+    cpu->neg.icount_decr.u16.low = low > k ? low - k : 0;
+}
